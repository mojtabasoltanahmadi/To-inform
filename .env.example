# =============================================================================
# Notify — environment configuration template
# Copy this file to .env and fill in all required values before first run.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend — Express API
# -----------------------------------------------------------------------------

# Port the backend container listens on internally (do NOT expose directly;
# Nginx proxies to it via the Docker bridge network).
PORT=3000

# Node environment.  Must be "production" for production deployments.
NODE_ENV=production

# JWT signing secret.  Generate a strong random value:
#   openssl rand -hex 32
# Minimum length: 32 characters.  Required in production.
JWT_SECRET=replace-with-openssl-rand-hex-32-output

# Comma-separated list of origins allowed by the CORS policy.
# In production this should be the public-facing URL of the frontend.
# If Nginx proxies everything on the same origin you can leave this empty
# because all API calls arrive as same-origin requests from Nginx.
CORS_ORIGINS=http://localhost

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------

# Connection URL for the Redis service.
# When using docker compose the hostname is the service name ("redis").
REDIS_URL=redis://redis:6379

# Redis password — set this and uncomment REDIS_ARGS in docker-compose.yml
# if you want Redis AUTH in production.
# REDIS_PASSWORD=replace-with-a-strong-password

# -----------------------------------------------------------------------------
# Frontend (build-time only — only needed if overriding the default /api path)
# -----------------------------------------------------------------------------

# Base URL that the browser uses when making API calls.
# Leave blank to use the default relative path "/api" which Nginx proxies
# to the backend.  Only set this when the API lives on a different domain.
# VITE_API_BASE_URL=
# -----------------------------------------------------------------------------
# Redis Configuration (Phase 5: Cache Isolation)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379
# در محیط‌های پشت فایروال یا سرورهای پارت:
REDIS_IMAGE=artnexus.partdp.ir/redis:7-alpine
# در محیط‌های توسعه عمومی با دسترسی آزاد به DockerHub:
# REDIS_IMAGE=redis:7-alpine
# -----------------------------------------------------------------------------
# Atlas Data Service Configuration (Phase 6)
# -----------------------------------------------------------------------------
ATLAS_BASE_URL=http://atlas-v4-dev.apipart.ir
ATLAS_PROJECT=ms-notify
ATLAS_NS_USERS=users
ATLAS_NS_TODOS=todos
ATLAS_TIMEOUT_MS=15000

# -----------------------------------------------------------------------------
# Part Public Services (Phase 8: Authentication & Profile)
# -----------------------------------------------------------------------------
PART_AUTH_URL=http://authentication-v7-dev.partdp.ir
PART_PROFILE_URL=http://profile-v7-dev.partdp.ir
PART_AUTH_SYSTEM=mojtaba_soltanahmadi
PART_AUTH_USER=mojtaba_soltanahmadi
PART_AUTH_PASS=mojtaba_soltanahmadi
