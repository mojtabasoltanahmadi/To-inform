# Root-level .dockerignore applies when docker compose builds from the repo root.

# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Build output
frontend/dist/

# Environment files — injected at runtime
.env
.env.*
!.env.example
!backend/.env.example

# Git
.git/
.gitignore

# Editor / OS
.vscode/
.idea/
*.DS_Store
Thumbs.db

# Logs and temp
*.log
logs/
tmp/
temp/

# Test artifacts
backend/test/
coverage/

# Audit screenshots
audit-screenshots/

# CI/CD
.github/
.gitlab-ci.yml
